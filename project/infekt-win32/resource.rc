/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAIN_MENU MENU
BEGIN
    POPUP "文件(&F)"
    BEGIN
        MENUITEM "打开...\tCtrl+O",             IDM_FILE_OPEN
        MENUITEM SEPARATOR
        POPUP "导出"
        BEGIN
            MENUITEM "导出为 PNG...\tCtrl+P",           IDM_EXPORT_PNG
            MENUITEM "导出为 PNG（透明）...",     IDM_EXPORT_PNG_TRANSP
            MENUITEM SEPARATOR
            MENUITEM "导出为 UTF-8 文本文件...\tCtrl+S", IDM_EXPORT_UTF8
            MENUITEM "导出为 UTF-16 文本文件...",      IDM_EXPORT_UTF16
            MENUITEM "导出为 CP437 NFO 文件...",       IDM_EXPORT_CP437
            MENUITEM SEPARATOR
            MENUITEM "导出为 HTML...",                  IDM_EXPORT_XHTML
            MENUITEM "导出为 HTML（Canvas）...",         IDM_EXPORT_XHTML_CANVAS
            MENUITEM SEPARATOR
            MENUITEM "导出为 PDF...",                   IDM_EXPORT_PDF
            MENUITEM "导出为 PDF（DIN 尺寸）...",        IDM_EXPORT_PDF_DIN
        END
        MENUITEM SEPARATOR
        MENUITEM "退出\tAlt+F4",                IDM_EXIT
    END
    POPUP "视图(&V)"
    BEGIN
        MENUITEM "渲染视图\tF2",                IDM_VIEW_RENDERED
        MENUITEM "经典视图\tF3",                 IDM_VIEW_CLASSIC
        MENUITEM "纯文本视图\tF4",               IDM_VIEW_TEXTONLY
        MENUITEM SEPARATOR
        MENUITEM "重新加载\tF5",                  IDM_VIEW_RELOAD
        MENUITEM "最佳宽度",               IDM_OPTIWIDTH
        MENUITEM SEPARATOR
        POPUP "缩放"
        BEGIN
            MENUITEM "放大\tCtrl++",             IDM_ZOOM_IN
            MENUITEM "缩小\tCtrl+-",            IDM_ZOOM_OUT
            MENUITEM SEPARATOR
            MENUITEM "重置\tCtrl+0",               IDM_ZOOM_RESET
        END
        MENUITEM SEPARATOR
        MENUITEM "始终置顶\tCtrl+T",       IDM_ALWAYSONTOP
        MENUITEM "显示状态栏",             IDM_SHOWSTATUSBAR
        MENUITEM "显示工具栏",                IDM_VIEW_SHOWTOOLBAR
    END
    POPUP "工具(&T)"
    BEGIN
        MENUITEM "设置\tF6",                IDM_SETTINGS
        MENUITEM SEPARATOR
        MENUITEM "下一个 NFO\tJ",                 IDM_TOOLS_NEXTNFO
        MENUITEM "上一个 NFO\tK",             IDM_TOOLS_PREVIOUSNFO
    END
    POPUP "帮助(&H)"
    BEGIN
        MENUITEM "检查更新...",        IDM_CHECKFORUPDATES
        MENUITEM SEPARATOR
        MENUITEM "关于...\tF1",                IDM_ABOUT
    END
END

IDR_CONTEXT_MENU MENU
BEGIN
    POPUP "."
    BEGIN
        MENUITEM "复制\tCtrl+C",                IDMC_COPY
        MENUITEM "全选\tCtrl+A",          IDMC_SELECTALL
        MENUITEM SEPARATOR
        MENUITEM "复制快捷方式",               IDMC_COPYSHORTCUT
        MENUITEM SEPARATOR
        MENUITEM "始终置顶\tCtrl+T",       IDMC_ALWAYSONTOP
        MENUITEM "切换工具栏\tCtrl+G",      IDMC_TOGGLE_TOOLBAR
        MENUITEM SEPARATOR
        MENUITEM "重新加载\tF5",                  IDMC_RELOAD
    END
END


